```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI Learning Assistant</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

  <div class="container">
    <h1>AI Learning Assistant</h1>

    <form id="taskForm">
      <label for="task">Choose a task:</label>

      <select id="task" name="task">
        <option value="Explain">Explain</option>
        <option value="QnA">QnA</option>
        <option value="Quiz">Quiz</option>
        <option value="Summary">Summary</option>
        <option value="Recommend Path">Recommend Path</option>
      </select>

      <label for="userInput">Enter your content:</label>

      <textarea
        id="userInput"
        name="userInput"
        rows="8"
        placeholder="Type your question or content here..."
      ></textarea>

      <button type="submit">Submit</button>
    </form>

    <div id="result" class="result">
      <h2>Result</h2>
      <p>Your result will appear here.</p>
    </div>
  </div>

</body>
</html>
